# Copy to ~/posit-poc.env (outside the repo), fill in, then:
#   chmod 600 ~/posit-poc.env && source ~/posit-poc.env
# Never commit the real file.

# Proxmox API (Molecule only)
export PVE_HOST=192.168.1.10
export PVE_NODE=pve
export PVE_USER=molecule@pve
export PVE_TOKEN_ID=ci
export PVE_TOKEN_SECRET='xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'

# Posit license keys
export PWB_LICENSE='XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX'
export PCT_LICENSE='XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX'
